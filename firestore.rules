rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Global Safety Net: Default-deny all unspecified documents
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // User Profile Document
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId) 
        && request.resource.data.uid == userId
        && request.resource.data.storeName is string
        && request.resource.data.storeName.size() > 0
        && request.resource.data.storeName.size() <= 200;
      allow delete: if false; // Disallow profile deletion via client

      // Sales Subcollection
      match /sales/{saleId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.profit is number
          && request.resource.data.date is string;
        allow delete: if isOwner(userId);
      }

      // Expenses Subcollection
      match /expenses/{expenseId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.title is string
          && request.resource.data.title.size() <= 250;
        allow delete: if isOwner(userId);
      }

      // MFS Subcollection
      match /mfs/{mfsId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.amount is number
          && request.resource.data.amount >= 0
          && request.resource.data.operator is string;
        allow delete: if isOwner(userId);
      }

      // Dues Subcollection
      match /dues/{dueId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.totalAmount is number
          && request.resource.data.totalAmount >= 0
          && request.resource.data.customerName is string;
        allow delete: if isOwner(userId);
      }

      // Customers Subcollection
      match /customers/{customerId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.name.size() <= 200;
        allow delete: if isOwner(userId);
      }

      // Accounts Subcollection
      match /accounts/{accountId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && request.resource.data.name is string
          && request.resource.data.balance is number;
        allow delete: if isOwner(userId);
      }
    }

  }
}
